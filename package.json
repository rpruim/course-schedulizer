{
  "name": "course-schedulizer-2",
  "version": "2.0.7.9002",
  "private": true,
  "license": "MIT",
  "description": "Course Schedulizer 2.0 (TypeScript)",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "build": "node tools/gen-settings.mjs && pnpm --filter @schedulizer/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && node --test tools/*.test.mjs",
    "lint": "eslint .",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "notices": "node tools/third-party-notices.mjs",
    "settings": "node tools/gen-settings.mjs",
    "examples": "node tools/make-examples.mjs",
    "check:prod": "pnpm build && pnpm --filter web exec vite preview --port 5174 --strictPort",
    "hooks": "git config core.hooksPath .githooks",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@11.24.0"
}
